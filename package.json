{
  "name": "clone-duolingo",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:frontend": "npm --prefix frontend run test",
    "dev:backend": "backend/.venv/bin/uvicorn app.main:app --reload --app-dir backend",
    "test:backend": "backend/.venv/bin/pytest backend/tests",
    "migrate:backend": "cd backend && .venv/bin/alembic upgrade head",
    "seed:backend": "cd backend && .venv/bin/python -m app.seed"
  }
}
